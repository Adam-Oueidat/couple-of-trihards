STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Public origin the browser reaches this app on, e.g. https://trilog.example.com
# (scheme + host, no trailing path). Every server-issued redirect is built from
# it. REQUIRED IN PRODUCTION for two reasons:
#   1. The standalone server derives request.url from the address it is BOUND to
#      ($HOSTNAME), so without this a post-login redirect sends the browser to
#      http://0.0.0.0:3000 instead of the site.
#   2. The only fallback is the Host header, which the client chooses — pinning
#      APP_URL is what makes redirects immune to host-header injection.
# Optional locally, where the Host header fallback is fine.
# APP_URL=http://localhost:3000

# Must be at least 32 chars — generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_a_random_32char_secret_here_please

# Anthropic API key for the AI coach chat — get one at console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Turso (libSQL). Dev and production deliberately share one database, so your
# training data has a single source of truth. Get these from:
#   turso db show <db> --url
#   turso db tokens create <db>
TURSO_DATABASE_URL=libsql://<your-db>.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here
#
# To work against a throwaway local copy instead (offline, or to try a risky
# migration), snapshot production and point at the file:
#   pnpm db:pull-prod
#   TURSO_DATABASE_URL=file:./.data/local.db  (and unset TURSO_AUTH_TOKEN)

# Comma-separated Strava athlete ids that can access /admin/* to mint
# license keys. Put your own id here for first-time setup.
ADMIN_ATHLETE_IDS=

# Number of trusted reverse proxies in front of the app (default 1, e.g. the
# platform edge). Used to read the real client IP from X-Forwarded-For for rate
# limiting; raise it only if you add more proxy hops.
# TRUSTED_PROXY_HOPS=1

# Upstash Redis for rate limiting in prod. If unset, the app falls back to
# an in-memory limiter (fine for single-process dev; not safe across replicas).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Mobile (Expo) deep-link scheme used to return the bearer token after Strava
# OAuth. The mobile app opens /api/auth/strava/start?redirect=<scheme>://callback
MOBILE_DEEP_LINK_SCHEME=trihard

# Absolute lifetime of a mobile bearer token in days (default 90). Expired
# tokens are rejected and the user must re-authenticate.
# MOBILE_TOKEN_TTL_DAYS=90

# Logger threshold: debug | info | warn | error (default: info)
# LOG_LEVEL=debug

# Minutes an unredeemed license key stays valid before being swept (default 5).
# Bound (in-use) keys are permanent and never expire.
# LICENSE_RETENTION_MINUTES=5

# (Optional) for the one-shot JSON import: your Strava athlete id.
# Run after first sign-in: SEED_STRAVA_ATHLETE_ID=12345 pnpm db:import
